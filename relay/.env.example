# Copy to .env for local testing, or set as Fly secrets for the real
# deployment: `fly secrets set TASTER_API_KEY=... WORKER_API_KEY=...`
# Never commit the real values.

# Shared bearer token the PWA sends — same value you configure in the PWA's
# setup screen.
TASTER_API_KEY=

# A SEPARATE bearer token, known only to the QNAP worker. Generate both
# independently:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_KEY=

# "*" is fine — the relay serves the PWA itself (same origin), so this only
# matters if you ever access the API from a different origin.
CORS_ALLOW_ORIGIN=*

# How long a claimed job can sit "processing" before another poll is
# allowed to re-claim it (covers a worker crash mid-job).
JOB_CLAIM_TIMEOUT_S=300
