# Copy to /share/Container/taster/couchdb.env on the NAS.
#
# These are the CouchDB ADMIN bootstrap credentials — the official CouchDB
# image creates this account on first boot using exactly these two variable
# names. This is a DIFFERENT account from the backend's own COUCHDB_USER /
# COUCHDB_PASSWORD in the main .env file (a least-privilege member account
# the backend authenticates as — see INSTALL.md for creating it once
# taster-couchdb is up).

COUCHDB_USER=admin
COUCHDB_PASSWORD=
