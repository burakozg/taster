# Copy to .env and fill in. Never commit the real .env — secrets only,
# model choice lives in config.yaml instead (see that file's header comment).
#
# This is the WORKER's env — it never accepts inbound connections, so there
# is no client-facing bearer token, CORS origin, or rate limit here anymore
# (that surface lives on the relay instead — see relay/.env.example).

ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — only needed if you select a gpt-* model in the PWA's Admin
# tab. Leave empty to use Claude models only.
OPENAI_API_KEY=

# OPTIONAL — only needed if you select a mistral-*/pixtral-* model in the PWA's
# Admin tab. Leave empty to use Claude (or OpenAI) models only.
MISTRAL_API_KEY=

# OPTIONAL — only needed if you select a namespaced vendor/model id (e.g.
# google/gemini-3.6-flash) in the PWA's Admin tab. Those route through
# OpenRouter, which is one key for every model family it fronts — Google, xAI,
# Moonshot, Qwen — so this is the key that unlocks the widest part of the
# dropdown. Credit-based: top up at openrouter.ai, no per-lab billing setup.
OPENROUTER_API_KEY=

COUCHDB_URL=http://taster-couchdb:5984
COUCHDB_DB=hobby
COUCHDB_USER=taster_backend
COUCHDB_PASSWORD=

# The Fly relay this worker polls (outbound only) for jobs, e.g.
# https://taster-relay.fly.dev — no trailing slash.
RELAY_URL=

# A SEPARATE bearer token from the relay's TASTER_API_KEY (which is the
# PWA's, client-side) — must match the relay's WORKER_API_KEY exactly.
# Generate independently: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WORKER_API_KEY=

# How often to poll the relay for new jobs, and how often to push a full
# items snapshot (also pushed immediately after every completed capture).
POLL_INTERVAL_S=3.0
ITEMS_SNAPSHOT_INTERVAL_S=60.0
