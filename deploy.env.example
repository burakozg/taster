# Copy to .deploy.env and fill in your real values. .deploy.env is git-ignored —
# never commit it. ./deploy auto-sources it, so these never need exporting by
# hand each session. See homelab/README.md for the contract these names follow.

# ssh destination for the NAS host itself. It must be the account that OWNS
# NAS_APP_DIR — ./deploy writes docker-compose.yml there. Give it a key
# (ssh-copy-id -p $NAS_SSH_PORT $NAS_SSH); with password auth every step prompts,
# and hangs rather than prompting when nothing can type.
NAS_SSH=admin@nas.local
NAS_SSH_PORT=22

# The NAS's actual CPU architecture — DO NOT GUESS. Check once:
#   ssh -p $NAS_SSH_PORT $NAS_SSH uname -m
# x86_64 → linux/amd64 · aarch64/arm64 → linux/arm64. Building for the wrong one
# produces a worker that dies with "exec format error" on first start — not a
# partial failure, a silent non-start.
NAS_PLATFORM=linux/amd64

# CouchDB's static address on the qnet macvlan — what Obsidian LiveSync clients
# on the LAN connect to, and what `./deploy check` probes. Must match
# APP_LAN_IP_COUCHDB in the NAS's own /share/Container/taster/.env, which is
# where qnap/docker-compose.yml reads it from. The worker has no LAN address at
# all: it only ever dials out.
APP_LAN_IP_COUCHDB=10.0.0.2

# Optional — only if your NAS directory or Container Station install differ from
# the defaults ./deploy assumes.
# NAS_APP_DIR=/share/Container/taster
# NAS_DOCKER_BIN=/share/CACHEDEV1_DATA/.qpkg/container-station/bin/docker
